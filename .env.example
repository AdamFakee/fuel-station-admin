# ==============================================================================
# Development Environment Configuration (.env)
# ==============================================================================
APP_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fuel_station_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fuel_station_db?sslmode=disable
DB_MAX_CONNS=20

# Backend Service
BACKEND_PORT=8080
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=dev_session_secret_key_at_least_32_characters_long!
STORAGE_LOCAL_DIR=./uploads
EDGE_HEARTBEAT_THRESHOLD_SECONDS=300

# Frontend Admin Portal
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_APP_NAME="Fuel Station Admin"
