# Production KHÔNG dùng file .env trên VPS: secret lưu ở GitHub (Settings -> Secrets and variables -> Actions)
# và được workflow .github/workflows/ci-cd.yml đưa vào lúc deploy. File này chỉ liệt kê tên biến.
#
# Secrets (bí mật):
#   DOCKER_USERNAME, DOCKER_PASSWORD   Docker Hub
#   VPS_HOST, VPS_PORT, VPS_PASSWORD   SSH tới VPS
#   POSTGRES_PASSWORD                  mật khẩu database      (openssl rand -base64 24)
#   DEVICE_CRYPTO_KEY                  đúng 32 ký tự           (openssl rand -hex 16)
#
# Variables (không bí mật, có mặc định):
#   NEXT_PUBLIC_API_URL                mặc định http://<VPS_HOST>:8080/v1
#   CORS_ALLOWED_ORIGINS               mặc định http://<VPS_HOST>:3000
#   POSTGRES_USER=fuel_admin
#   POSTGRES_DB=fuel_station_db
