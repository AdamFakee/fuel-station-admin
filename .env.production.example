# ==============================================================================
# Production Environment Configuration (.env.production)
# ==============================================================================
APP_ENV=production

# Database Configuration (Thay đổi bằng mật khẩu mạnh trên production)
POSTGRES_USER=fuel_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_123!
POSTGRES_DB=fuel_station_prod
POSTGRES_PORT=5432
DB_MAX_CONNS=50

# Backend Service
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=https://admin.fuelstation.vn
SESSION_SECRET=GENERATE_RANDOM_SECRET_KEY_MIN_32_CHARS_LONG
STORAGE_LOCAL_DIR=/app/uploads
EDGE_HEARTBEAT_THRESHOLD_SECONDS=300

# Frontend Admin Portal
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=https://api.fuelstation.vn/v1
NEXT_PUBLIC_APP_NAME="Hệ Thống Trạm Nhiên Liệu Nội Bộ"
